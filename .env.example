# Session auth (required for login)
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_BOOTSTRAP_PASSWORD=admin123
# Set COOKIE_SECURE=true behind HTTPS in production
COOKIE_SECURE=false

# Google Cloud OAuth Web client (Sheets API enabled)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8079/api/google/callback
# In production (e.g. khairulpm.sobhoy.com):
# GOOGLE_REDIRECT_URI=https://khairulpm.sobhoy.com/api/google/callback

# Private spreadsheet (Viewer access via your Google account is enough)
GOOGLE_SHEET_ID=1ha_1ty00uNlMAqPeLe5Rg946IQl5GbYagAS5oRHzseE
# Fallback single tab if no prefix matches
GOOGLE_SHEET_GID=1486932215
# Pull every tab whose name starts with this (e.g. "STA Aug 2026", "STA July 2026")
GOOGLE_SHEET_TAB_PREFIX=STA

# AI Project Assistant (Free Groq Cloud LPU or OpenAI-compatible)
# 1. Get a free API key at https://console.groq.com
# 2. Add your key below:
GROQ_API_KEY=
# Optional overrides:
AI_MODEL=llama-3.1-8b-instant
AI_BASE_URL=https://api.groq.com/openai/v1

# AI Agent Rate Limiting & Quota (5-Hour Window or 24-Hour Daily)
AGENT_QUOTA_WINDOW_HOURS=5
AGENT_WORK_TASK_LIMIT=3
AGENT_CHAT_LIMIT=25
AGENT_SUPERADMIN_UNLIMITED=true
